digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad=0.3, nodesep=0.38, ranksep=0.7, splines=spline, fontname="DejaVu Sans", labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.14", color="#64748b", fontcolor="#0f172a", penwidth=1.2];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", fontcolor="#475569", arrowsize=0.7];
route [label="receive_audio() route\nAuth + multipart validation",fillcolor="#cffafe"];
receive [label="AudioService.receive_upload()\nCopy 64 KiB chunks into temp file",fillcolor="#fef3c7"];
probe [label="probe_audio()\nFFprobe metadata → AudioMetadata",fillcolor="#fef3c7"];
fallback [label="measure_packet_duration()\nScan packets for duration-less WebM",fillcolor="#fef3c7"];
duration [label="validate_duration()\nReject audio longer than limit",fillcolor="#fef3c7"];
normalize [label="get_normalized_metadata()\nnormalize_audio(): FFmpeg WAV",fillcolor="#fef3c7"];
reprobe [label="probe_audio(normalized WAV)\nRecheck decoded duration",fillcolor="#fef3c7"];
vad [label="detect_speech()\nPCM → float samples → Silero\nCached ONNX model, guarded by lock",fillcolor="#fef3c7"];
clips [label="extract_speech_clips()\nCopy ordered speech ranges to WAVs",fillcolor="#fef3c7"];
transcribe [label="TranscriptionService.transcribe_clips()\nSequential clip requests",fillcolor="#fef3c7"];
provider [label="GroqProvider.transcribe()\ncreate_groq_client() → verbose JSON\nValidate ClipTranscription",fillcolor="#ffe4e6"];
merge [label="Merge text + unique languages\nClamp clip ends; add original offsets",fillcolor="#fef3c7"];
empty [label="No speech ranges\nEmpty transcript; no Groq calls",fillcolor="#fef3c7"];
save [label="AudioStorageService.save()\nPersist original + COMPLETED job",fillcolor="#dcfce7"];
cleanup [label="Return SavedAudio / error\nDelete temporary files; close upload",fillcolor="#cffafe"];
errors [label="Errors returned by route\n400 bad audio · 413 limit\n502 provider · 503 unavailable\n500 storage; 422 request validation",fillcolor="#fee2e2"];
route -> receive [label="authenticated request"];
receive -> probe [label="under size limit"];
probe -> fallback [label="missing duration"];
fallback -> duration [label="packet span"];
probe -> duration [label="duration available"];
duration -> normalize [label="within limit"];
normalize -> reprobe [label="mono 16 kHz PCM"];
reprobe -> vad [label="decoded length valid"];
vad -> clips [label="speech ranges"];
clips -> transcribe [label="temporary clips"];
transcribe -> provider [label="each clip"];
provider -> merge [label="validated response"];
transcribe -> empty [label="zero clips"];
merge -> save [label="full result"];
empty -> save [label="successful no-speech result"];
save -> cleanup [label="commit successful"];
receive -> errors [label="oversize"];
provider -> errors [label="missing key / provider error"];
normalize -> errors [label="decode / tool error"];
errors -> cleanup [label="finally"];
}