digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad=0.3, nodesep=0.38, ranksep=0.7, splines=spline, fontname="DejaVu Sans", labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.14", color="#64748b", fontcolor="#0f172a", penwidth=1.2];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", fontcolor="#475569", arrowsize=0.7];
mount [label="App mount\nloadUser() → fetchUser()",fillcolor="#dbeafe"];
me [label="GET /auth/me\nget_me() route",fillcolor="#cffafe"];
dep [label="get_current_user() dependency\nRead access_token cookie",fillcolor="#ede9fe"];
valid [label="AuthService.get_current_user()\ndecode_access_token() + UUID subject",fillcolor="#ede9fe"];
lookup [label="UserRepository.get_by_id()\nReturn user or reject",fillcolor="#dcfce7"];
profile [label="Public user profile\nApp renders AudioWorkspace",fillcolor="#dbeafe"];
login [label="Login + GoogleLoginButton\nGoogle supplies credential",fillcolor="#dbeafe"];
post [label="handleCredentialResponse()\nPOST /auth/google",fillcolor="#dbeafe"];
verify [label="AuthService.login_with_google()\nVerify Google token + audience",fillcolor="#ede9fe"];
find [label="get_by_google_id()\ncreate() if new; user insert commits",fillcolor="#dcfce7"];
tokens [label="create_access_token()\ngenerate_refresh_token()\nhash_refresh_token() + expiry",fillcolor="#ede9fe"];
session [label="RefreshSessionRepository.create()\nFlush hash → service commits",fillcolor="#dcfce7"];
cookies [label="set_auth_cookies()\nAccess path / · refresh path /auth",fillcolor="#ede9fe"];
fail [label="Invalid access / identity\n401 → refresh or sign-in screen",fillcolor="#fee2e2"];
mount -> me [label="session check"];
me -> dep [label="Depends"];
dep -> valid [label="cookie present"];
valid -> lookup [label="valid JWT"];
lookup -> profile [label="existing user"];
dep -> fail [label="missing cookie"];
valid -> fail [label="invalid token"];
lookup -> fail [label="missing user"];
login -> post [label="callback"];
post -> verify [label="credential"];
verify -> find [label="verified identity"];
verify -> fail [label="invalid Google token"];
find -> tokens [label="user UUID"];
tokens -> session [label="only token hash"];
session -> cookies [label="after commit"];
cookies -> mount [label="handleLogin() rechecks user"];
}