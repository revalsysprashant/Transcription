        "refresh",
        "POST /auth/refresh\nAuthService.refresh_tokens()",
        "auth"
      ],
      [
        "revoke",
        "hash_refresh_token() → revoke()\nConditional UPDATE, active_only=True",
        "data"
      ],
      [
        "replace",
        "get_by_id() + new token pair\ncreate() replacement hash",
        "auth"
      ],
      [
        "commit",
