digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad=0.3, nodesep=0.38, ranksep=0.7, splines=spline, fontname="DejaVu Sans", labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.14", color="#64748b", fontcolor="#0f172a", penwidth=1.2];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", fontcolor="#475569", arrowsize=0.7];
app [label="App()\nUser / loading / logout / audioBusy",fillcolor="#dbeafe"];
workspace [label="AudioWorkspace()\nFile · language · job · pending · errors",fillcolor="#dbeafe"];
limits [label="loadAudioLimits()\nGET /audio/limits",fillcolor="#cffafe"];
start [label="AudioRecorder.start()\nCheck support → getUserMedia()",fillcolor="#dbeafe"];
rec [label="MediaRecorder\nChoose WebM / MP4 / Ogg\nEmit chunks every 1000 ms",fillcolor="#dbeafe"];
data [label="ondataavailable\nCount bytes; collect chunks",fillcolor="#dbeafe"];
stop [label="stop() / duration timer\nStop recorder and media tracks",fillcolor="#dbeafe"];
final [label="onstop\nBlob → File → preview URL\nonReady(file)",fillcolor="#dbeafe"];
choose [label="File picker onChange\nsetFile(selected file)",fillcolor="#dbeafe"];
upload [label="handleUpload()\nValidate nonempty file and size",fillcolor="#dbeafe"];
action [label="runAction()\nPrevent overlap; set pending; catch errors",fillcolor="#dbeafe"];
send [label="uploadAudio()\nFormData file + optional language",fillcolor="#cffafe"];
render [label="setJob() + setJobId()\nRender results and saved-job notice",fillcolor="#dbeafe"];
error [label="Microphone / size / recording error\nShow feedback; release tracks",fillcolor="#fee2e2"];
clean [label="Unmount / preview cleanup\nClear timer · stop tracks\nRevoke obsolete object URLs",fillcolor="#dbeafe"];
app -> workspace [label="props + callbacks"];
workspace -> limits [label="mount effect"];
workspace -> start [label="record button"];
limits -> data [label="size limit"];
limits -> stop [label="duration limit"];
start -> rec [label="permission granted"];
start -> error [label="denied / unsupported"];
rec -> data [label="encoded chunks"];
data -> stop [label="manual stop / size limit"];
stop -> final [label="final data event then stop event"];
data -> error [label="too large"];
final -> upload [label="recorded File selected"];
choose -> upload [label="uploaded File selected"];
upload -> action [label="valid file"];
action -> send [label="await request"];
send -> render [label="SavedJob"];
rec -> clean [label="unmount"];
final -> clean [label="preview replaced"];
}