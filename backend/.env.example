DATABASE_URL=postgresql+asyncpg://{username}:{password}@localhost:{port}/{db-name}
APP_NAME=Transcription API
APP_ENV=development
DEBUG=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Add your key locally; never commit it.
GROQ_API_KEY=api-key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Defaults to backend/storage/audio; use an absolute path to override.
# AUDIO_STORAGE_DIR=/absolute/path/to/audio

# Upload limits: decimal MB (1 MB = 1,000,000 bytes) and seconds.
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=3600
