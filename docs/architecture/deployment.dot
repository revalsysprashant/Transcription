tls [label="Automatic HTTPS\nCertificates persist in volume\nSecure cookies enabled",fillcolor="#ede9fe"];
volumes [label="Named volumes\nDatabase · audio · certificates\nSurvive container replacement",fillcolor="#dcfce7"];
local [label="Local Docker alternative\n127.0.0.1:8080 → Caddy :80\nSeparate DB; cookie_secure=false",fillcolor="#e2e8f0"];
shutdown [label="lifespan() shutdown\nDispose database engine",fillcolor="#cffafe"];
env -> compose [label="configuration"];
package -> server [label="copy archive + env separately"];
server -> compose [label="Docker installed"];
compose -> db [label="start first"];
