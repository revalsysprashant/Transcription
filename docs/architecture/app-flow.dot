digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad=0.3, nodesep=0.38, ranksep=0.7, splines=spline, fontname="DejaVu Sans", labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.14", color="#64748b", fontcolor="#0f172a", penwidth=1.2];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", fontcolor="#475569", arrowsize=0.7];
user [label="User\nSign in · record · upload",fillcolor="#dbeafe"];
react [label="React application\nApp + AudioWorkspace",fillcolor="#dbeafe"];
google [label="Google Identity\nBrowser credential / verified identity",fillcolor="#ffe4e6"];
proxy [label="Caddy / same origin\nHTTPS in production",fillcolor="#e2e8f0"];
auth [label="Authentication\nGoogle login · JWT · refresh rotation",fillcolor="#ede9fe"];
api [label="Audio routes\nAuthenticated owner checks",fillcolor="#cffafe"];
processing [label="Audio processing\nFFprobe → FFmpeg → Silero",fillcolor="#fef3c7"];
groq [label="Groq Whisper\nTranscribe speech clips",fillcolor="#ffe4e6"];
storage [label="Save completed job\nCopy original + commit transcript",fillcolor="#dcfce7"];
db [label="PostgreSQL\nUsers · sessions · transcriptions",fillcolor="#dcfce7"];
disk [label="Persistent audio volume\nOriginal recordings only",fillcolor="#dcfce7"];
result [label="Result in browser\nTranscript · timestamps · exports",fillcolor="#dbeafe"];
user -> react [label="interacts"];
react -> google [label="sign in"];
react -> proxy [label="HTTP + cookies"];
proxy -> auth [label="/auth/*"];
proxy -> api [label="/audio/*"];
google -> auth [label="credential verification"];
auth -> db [label="users + session hashes"];
api -> processing [label="upload"];
processing -> groq [label="speech WAV clips"];
groq -> storage [label="validated text + times"];
processing -> storage [label="no speech: empty result"];
storage -> db [label="COMPLETED row"];
storage -> disk [label="original bytes"];
storage -> result [label="upload response via API"];
api -> result [label="owned job / original / export"];
}