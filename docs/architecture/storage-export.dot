digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad=0.3, nodesep=0.38, ranksep=0.7, splines=spline, fontname="DejaVu Sans", labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.14", color="#64748b", fontcolor="#0f172a", penwidth=1.2];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", fontcolor="#475569", arrowsize=0.7];
save [label="AudioStorageService.save()\nGenerate UUID + SavedAudio response",fillcolor="#dcfce7"];
copy [label="StorageRepository.save_original()\nExclusive file creation\nuser UUID / job UUID.audio",fillcolor="#dcfce7"];
insert [label="TranscriptionRepository.create_completed()\nExact bytes + JSON segments\nFlush COMPLETED row",fillcolor="#dcfce7"];
commit [label="db.commit()\nReturn upload result",fillcolor="#dcfce7"];
undo [label="Failure compensation\nRollback + remove_original()\nAudioStorageError",fillcolor="#fee2e2"];
lookup [label="handleLookup() → loadAudioJob()\nGET /audio/{job_id}",fillcolor="#dbeafe"];
get [label="get_saved_audio() → get_saved()\nget_owned(job_id, user_id)",fillcolor="#cffafe"];
saved [label="SavedTranscription\nsize_mb computed; internal path omitted",fillcolor="#dcfce7"];
download [label="handleDownload()\ndownloadAudio() / downloadTranscript()",fillcolor="#dbeafe"];
original [label="download_audio() → get_download()\nget_owned() then get_original_path()\nSanitize download filename",fillcolor="#cffafe"];
export [label="export_transcript() → get_saved()\nrender_transcript()",fillcolor="#cffafe"];
format [label="TXT: full text\nSRT / VTT: subtitle_timestamp()\nEscape cue text, skip zero-length cues",fillcolor="#fef3c7"];
blob [label="Response blob → object URL\nTemporary download link\nRevoke URL after starting download",fillcolor="#dbeafe"];
missing [label="404\nNot owned / missing record\nOriginal missing on disk",fillcolor="#fee2e2"];
save -> copy [label="temporary original"];
copy -> insert [label="relative storage key"];
insert -> commit [label="staged row"];
copy -> undo [label="normal copy failure"];
insert -> undo [label="DB failure"];
lookup -> get [label="job ID"];
get -> saved [label="owned"];
get -> missing [label="not found"];
download -> original [label="original bytes"];
download -> export [label="txt / srt / vtt"];
original -> blob [label="FileResponse"];
original -> missing [label="not accessible"];
export -> format [label="owned transcript"];
export -> missing [label="not found"];
format -> blob [label="UTF-8 response"];
}