      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Prevents duplicate starts, checks browser support, requests microphone access, chooses\nsupported WebM/MP4/Ogg MIME type, registers media callbacks, and starts one-second\nchunk capture. Clears the previous selected file and schedules duration stop. Releases\ntracks after cancellation, unmount, or errors.",
      "originalText": "Prevents duplicate starts, checks browser support, requests microphone access, chooses\nsupported WebM/MP4/Ogg MIME type, registers media callbacks, and starts one-second\nchunk capture. Clears the previous selected file and schedules duration stop. Releases\ntracks after cancellation, unmount, or errors.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 16
    },
